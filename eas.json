{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "preview-arm64": {
      "distribution": "internal",
      "environment": "production",
      "android": { "buildType": "apk" },
      "env": { "RETURNIT_ABIS": "arm64-v8a" }
    },
    "production": {
      "android": { "buildType": "apk" },
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}