{
  "expo": {
    "name": "Returnit",
    "slug": "Returnit",
    "version": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.returnit.app",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.returnit.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "ReturnIt memakai Face ID untuk membuka kunci aplikasi." }],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e4eb61c1-3ff9-42ba-af70-6d1266f14286"
      }
    },
    "owner": "lildwagzs-team"
  }
}
